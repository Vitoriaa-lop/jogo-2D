const canvas = document.getElementById("gameCanvas");
const ctx = canvas.getContext("2d");

// Carregar a nova imagem de fundo mística
const bgImage = new Image();
bgImage.src = "img/fundo.jpg";

// Posição de rolagem contínua do fundo
let bgScrollX = 0;
const scrollSpeed = 0.8; // Velocidade do movimento do cenário

// Ajustar o tamanho do Canvas para Tela Cheia
function resizeCanvas() {
  canvas.width = window.innerWidth;
  canvas.height = window.innerHeight;
  updatePositions();
}

window.addEventListener("resize", resizeCanvas);

const gravity = 0.5;

// Mapeamento de Teclas
const keys = {};
window.addEventListener("keydown", (e) => (keys[e.key] = true));
window.addEventListener("keyup", (e) => (keys[e.key] = false));

// Jogador 1 (Vermelho / Fogo)
const player1 = {
  x: 60,
  y: 0,
  width: 32,
  height: 44,
  color: "#ff4d4d",
  vx: 0,
  vy: 0,
  speed: 5,
  jumpPower: -11,
  grounded: false,
};

// Jogador 2 (Azul / Água)
const player2 = {
  x: 120,
  y: 0,
  width: 32,
  height: 44,
  color: "#4cc9f0",
  vx: 0,
  vy: 0,
  speed: 5,
  jumpPower: -11,
  grounded: false,
};

// Elementos do Cenário
let platforms = [];
let button = {};
let door = {};
let exitZone = {};

function updatePositions() {
  const w = canvas.width;
  const h = canvas.height;

  // Plataformas alinhadas com o novo chão
  platforms = [
    { x: 0, y: h - 75, width: w, height: 75 },            // Chão Principal
    { x: w * 0.18, y: h - 190, width: w * 0.28, height: 18 }, // Plataforma Esquerda
    { x: w * 0.55, y: h - 300, width: w * 0.35, height: 18 }, // Plataforma Direita
  ];

  button = { x: w * 0.28, y: h - 200, width: 45, height: 10, pressed: false };
  door = { x: w * 0.78, y: h - 400, width: 18, height: 100, open: false };
  exitZone = { x: w * 0.82, y: h - 380, width: 80, height: 80 };

  if (player1.y === 0) player1.y = h - 150;
  if (player2.y === 0) player2.y = h - 150;
}

function updatePlayer(p, controls) {
  // Movimento Horizontal
  if (keys[controls.left]) p.vx = -p.speed;
  else if (keys[controls.right]) p.vx = p.speed;
  else p.vx = 0;

  // Pulo
  if (keys[controls.jump] && p.grounded) {
    p.vy = p.jumpPower;
    p.grounded = false;
  }

  // Gravidade
  p.vy += gravity;

  // Atualização de Posição
  p.x += p.vx;
  p.y += p.vy;

  // Colisão com Plataformas
  p.grounded = false;
  for (let plat of platforms) {
    if (
      p.x < plat.x + plat.width &&
      p.x + p.width > plat.x &&
      p.y + p.height > plat.y &&
      p.y + p.height - p.vy <= plat.y
    ) {
      p.y = plat.y - p.height;
      p.vy = 0;
      p.grounded = true;
    }
  }

  // Colisão com Porta Fechada
  if (!door.open) {
    if (
      p.x < door.x + door.width &&
      p.x + p.width > door.x &&
      p.y < door.y + door.height &&
      p.y + p.height > door.y
    ) {
      if (p.vx > 0) p.x = door.x - p.width;
      if (p.vx < 0) p.x = door.x + door.width;
    }
  }

  // Limites da Tela
  if (p.x < 0) p.x = 0;
  if (p.x + p.width > canvas.width) p.x = canvas.width - p.width;
}

function checkPuzzle() {
  // Ativação do Botão
  const p1OnButton =
    player1.x < button.x + button.width &&
    player1.x + player1.width > button.x &&
    player1.y + player1.height >= button.y &&
    player1.y < button.y + button.height;

  const p2OnButton =
    player2.x < button.x + button.width &&
    player2.x + player2.width > button.x &&
    player2.y + player2.height >= button.y &&
    player2.y < button.y + button.height;

  button.pressed = p1OnButton || p2OnButton;
  door.open = button.pressed;

  // Vitórias
  const p1InExit = player1.x > exitZone.x && player1.x + player1.width < exitZone.x + exitZone.width;
  const p2InExit = player2.x > exitZone.x && player2.x + player2.width < exitZone.x + exitZone.width;

  if (p1InExit && p2InExit) {
    setTimeout(() => alert("Fase Concluída com Sucesso! 🎉"), 10);
    player1.x = 60; player1.y = canvas.height - 150;
    player2.x = 120; player2.y = canvas.height - 150;
  }
}

function draw() {
  ctx.clearRect(0, 0, canvas.width, canvas.height);

  // 1. Atualizar e Desenhar Fundo Mágico em Movimento Contínuo
  bgScrollX -= scrollSpeed;
  if (bgScrollX <= -canvas.width) {
    bgScrollX = 0;
  }

  if (bgImage.complete) {
    ctx.drawImage(bgImage, bgScrollX, 0, canvas.width, canvas.height);
    ctx.drawImage(bgImage, bgScrollX + canvas.width, 0, canvas.width, canvas.height);
  }

  // 2. Plataformas Semitransparentes
  ctx.fillStyle = "rgba(25, 45, 30, 0.65)";
  platforms.forEach((plat) => ctx.fillRect(plat.x, plat.y, plat.width, plat.height));

  // 3. Botão do Puzzle
  ctx.fillStyle = button.pressed ? "#ffb703" : "#fb8500";
  ctx.fillRect(button.x, button.pressed ? button.y + 5 : button.y, button.width, button.pressed ? 5 : 10);

  // 4. Porta do Puzzle
  if (!door.open) {
    ctx.fillStyle = "#e63946";
    ctx.fillRect(door.x, door.y, door.width, door.height);
  }

  // 5. Portal de Saída
  ctx.fillStyle = "rgba(255, 255, 255, 0.35)";
  ctx.fillRect(exitZone.x, exitZone.y, exitZone.width, exitZone.height);

  // 6. Texto Informativo
  ctx.fillStyle = "#ffffff";
  ctx.font = "18px Arial";
  ctx.fillText("P1 (Vermelho): W, A, D | P2 (Azul): Setas do Teclado", 20, 35);

  // 7. Personagens
  ctx.fillStyle = player1.color;
  ctx.fillRect(player1.x, player1.y, player1.width, player1.height);

  ctx.fillStyle = player2.color;
  ctx.fillRect(player2.x, player2.y, player2.width, player2.height);
}

function loop() {
  updatePlayer(player1, { left: "a", right: "d", jump: "w" });
  updatePlayer(player2, { left: "ArrowLeft", right: "ArrowRight", jump: "ArrowUp" });
  checkPuzzle();
  draw();
  requestAnimationFrame(loop);
}

// Inicialização
resizeCanvas();
bgImage.onload = () => {
  loop();
};
if (bgImage.complete) {
  loop();
}